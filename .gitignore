*.pem
*.key
*.crt
*.p12
secrets.*

# local database dumps (contain real user data / encrypted tokens)
backups/

# build artifacts
coverage/
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editor
.DS_Store
.vscode/

# local secrets / generated state
*.sqlite
*.db
*.db-journal
